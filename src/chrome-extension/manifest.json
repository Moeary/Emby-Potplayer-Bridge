{
  "manifest_version": 3,
  "name": "Emby/Jellyfin PotPlayer 播放桥",
  "version": "0.8.1",
  "description": "按默认设置或临时选择网页播放器与本机 PotPlayer 播放 Emby/Jellyfin 的单项、播放全部或随机播放。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://emby.moear.de/*",
    "https://jellyfin.moear.de/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Emby/Jellyfin PotPlayer 设置",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://emby.moear.de/*",
        "https://jellyfin.moear.de/*"
      ],
      "js": ["settings.js", "adapters/provider-core.js", "adapters/emby.js", "adapters/jellyfin.js", "page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://emby.moear.de/*",
        "https://jellyfin.moear.de/*"
      ],
      "js": ["settings.js", "playback-choice.js", "content-script.js"],
      "css": ["playback-choice.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
